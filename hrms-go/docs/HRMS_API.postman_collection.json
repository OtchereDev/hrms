  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.id) {",
                  "        pm.collectionVariables.set('employee_id', response.data.id);",
                  "        console.log('User registered with ID:', response.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"SecureP@ssw0rd123\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"role\": \"Employee\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/method/hrms.api.register",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "hrms.api.register"]
            },
            "description": "Register a new user account"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.token) {",
                  "        pm.collectionVariables.set('access_token', response.data.token);",
                  "        pm.collectionVariables.set('employee_id', response.data.user.employee_id);",
                  "        console.log('Login successful! Token saved.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"SecureP@ssw0rd123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/method/hrms.api.login",
              "host": ["{{base_url}}"],
              "path": ["api", "method", "hrms.api.login"]
            },
            "description": "Login and receive JWT token"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for registration and login"
    },
