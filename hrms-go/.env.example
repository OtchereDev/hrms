# Application Settings
APP_NAME=HRMS
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT=100

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hrms
DB_SSL_MODE=disable
DB_MAX_CONNS=100
DB_MAX_IDLE=10

# JWT Settings
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=hrms-api
JWT_REFRESH_ENABLED=true

# Storage Settings
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# S3 Settings (if using S3 storage)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Settings
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@hrms.local
SMTP_USE_TLS=true
